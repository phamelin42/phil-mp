{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/index.csr.html",
          "/*/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/favicon.svg"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/icons/*.png", "/illustrations/*.svg"] }
    }
  ]
}
