{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "MicroProduit",
  "title": "Micro-produit",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Identifiant du produit dans produits.json (devient projects/<slug>).",
      "pattern": "^[a-z][a-z0-9-]*$",
      "$default": { "$source": "argv", "index": 0 }
    }
  },
  "required": ["slug"]
}
