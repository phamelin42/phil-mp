            },
            "development": {
              "buildTarget": "devis-artisan:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/devis-artisan/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/devis-artisan/**/*.ts",
              "projects/devis-artisan/**/*.html"
            ]
          }
        }
      }
    },
    "garde-alternee": {
