{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "core": {
      "projectType": "library",
      "root": "libs/core",
      "sourceRoot": "libs/core/src",
      "prefix": "mp",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "vitrine:build:development",
            "tsConfig": "libs/core/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/core/**/*.ts", "libs/core/**/*.html"]
          }
        }
      }
    },
    "ui": {
      "projectType": "library",
      "root": "libs/ui",
      "sourceRoot": "libs/ui/src",
      "prefix": "mp",
      "architect": {
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "vitrine:build:development",
            "tsConfig": "libs/ui/tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["libs/ui/**/*.ts", "libs/ui/**/*.html"]
          }
        }
      }
    },
    "vitrine": {
      "projectType": "application",
      "root": "projects/vitrine",
      "sourceRoot": "projects/vitrine/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/vitrine",
            "browser": "projects/vitrine/src/main.ts",
            "server": "projects/vitrine/src/main.server.ts",
            "tsConfig": "projects/vitrine/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/vitrine/public"
              }
            ],
            "styles": [
              "projects/vitrine/src/styles.css",
              {
                "input": "libs/ui/styles/print.css",
                "bundleName": "print",
                "inject": false
              }
            ],
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kB",
                  "maximumError": "340kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kB",
                  "maximumError": "4kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              },
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "vitrine:build:production"
            },
            "development": {
              "buildTarget": "vitrine:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["projects/vitrine/**/*.ts", "projects/vitrine/**/*.html"]
          }
        }
      }
    },
    "devis-artisan": {
      "projectType": "application",
      "root": "projects/devis-artisan",
      "sourceRoot": "projects/devis-artisan/src",
      "prefix": "app",
