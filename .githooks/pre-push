#!/bin/sh
# Garde-fou : rien ne part vers GitHub sans que tout ce que vérifie le job CI
# soit vert sur ce poste (lint, format, tests, build pré-rendu, puis audit
# Playwright). Branché par `tools/installer-hooks.mjs` (script npm `prepare`).
#
# Pour passer outre une fois, en connaissance de cause : git push --no-verify

set -u

if [ "${CI:-}" = "true" ]; then
  exit 0
fi

# Une suppression de branche (sha local à zéro) ne publie aucun code.
a_pousser=0
while read -r _ref_local sha_local _ref_distant _sha_distant; do
  case "$sha_local" in
    *[!0]*) a_pousser=1 ;;
  esac
done
if [ "$a_pousser" -eq 0 ]; then
  exit 0
fi

echo "pre-push : npm run verify:ci (lint, format, tests, build, audit Playwright)."
echo "           Pour sauter : git push --no-verify"

if npm run verify:ci; then
  exit 0
fi

echo "pre-push : verify:ci a échoué, push annulé." >&2
echo "           Corrige la cause ; ne désactive ni une règle, ni un test, ni un contrôle." >&2
echo "           Navigateur manquant ? npx playwright install chromium" >&2
exit 1
